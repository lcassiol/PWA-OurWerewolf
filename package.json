{
  "name": "our-werewolf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.3"
    }
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @our-werewolf/web",
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev -w @our-werewolf/server\" \"npm run dev -w @our-werewolf/web\"",
    "e2e:serve": "node scripts/e2e-server.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p e2e/tsconfig.json",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.10",
    "vitest": "^4.0.6"
  }
}
